<Window x:Class="MCTL.Views.JavaDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动安装 Java" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Style="{StaticResource Card}" Margin="14" Padding="24">
        <StackPanel>
            <TextBlock Text="自动安装 Java 运行时" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource HeadingBrush}" />
            <TextBlock x:Name="DetailText" Text="准备中…" FontSize="11.5" Margin="0,10,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" />

            <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,16,0,0" />
            <TextBlock x:Name="StatusText" Text="正在连接…" FontSize="11" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" />

            <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource Btn}" Height="32" Padding="18,0"
                    HorizontalAlignment="Right" Margin="0,18,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Border>
</Window>
