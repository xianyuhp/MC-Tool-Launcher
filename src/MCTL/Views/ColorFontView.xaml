<UserControl x:Class="MCTL.Views.ColorFontView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6,2,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,10">
            <TextBlock Text="颜色字体" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />
            <TextBlock Text="生成 § 颜色代码 / 渐变字体，可一键转换为 Java 可用的 \u00A7 转义。"
                       Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 设置 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="输入文字" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                        <TextBox x:Name="InputBox" Style="{StaticResource Input}" Height="72" Margin="0,6,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontSize="13"
                                 Text="MCTL 启动器 · 渐变字体" TextChanged="Option_Changed" />

                        <TextBlock Text="颜色模式" FontSize="12" Margin="0,12,0,4"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeSolid" Style="{StaticResource Chip}" Content="纯色"
                                         GroupName="colormode" IsChecked="True" Checked="Mode_Changed" />
                            <RadioButton x:Name="ModeGradient" Style="{StaticResource Chip}" Content="渐变（多段）"
                                         GroupName="colormode" Checked="Mode_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="PaletteArea" Margin="0,10,0,0" />

                        <TextBlock Text="字体样式" FontSize="12" Margin="0,12,0,2"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <WrapPanel>
                            <CheckBox x:Name="BoldChk" Content="粗体" Margin="0,0,12,0" FontSize="11"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox x:Name="ItalicChk" Content="斜体" Margin="0,0,12,0" FontSize="11"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox x:Name="UnderlineChk" Content="下划线" Margin="0,0,12,0" FontSize="11"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox x:Name="StrikeChk" Content="删除线" Margin="0,0,12,0" FontSize="11"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox x:Name="ObfuscatedChk" Content="乱码" FontSize="11"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                        </WrapPanel>

                        <TextBlock Text="输出格式" FontSize="12" Margin="0,10,0,4"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="OutputRaw" Style="{StaticResource Chip}" Content="§ 直接输入"
                                         GroupName="outformat" IsChecked="True" Checked="OutputRaw_Checked" />
                            <RadioButton x:Name="OutputJava" Style="{StaticResource Chip}" Content="\u00A7（Java）"
                                         GroupName="outformat" Checked="OutputJava_Checked" />
                        </StackPanel>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="生成代码" Style="{StaticResource PrimaryBtn}" Padding="16,7"
                                    Margin="0,0,8,6" Click="Generate_Click" />
                            <Button Content="复制" Style="{StaticResource Btn}" Padding="14,7"
                                    Margin="0,0,8,6" Click="Copy_Click" />
                            <Button Content="清空" Style="{StaticResource Btn}" Padding="14,7"
                                    Margin="0,0,0,6" Click="Clear_Click" />
                        </WrapPanel>
                        <TextBlock Text="提示：§ 代码可直接粘贴到服务器 MOTD、告示牌、计分板或物品名称中；Lore / NBT 里通常需要 \u00A7 写法。"
                                   FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 预览与输出 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="效果预览" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                    <Border Grid.Row="1" Margin="0,8,0,0" Padding="16,14" CornerRadius="10"
                            Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" MinHeight="90">
                        <TextBlock x:Name="PreviewText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="2" Margin="0,14,0,6">
                        <TextBlock Text="生成的代码" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                        <TextBlock x:Name="CodeHint" HorizontalAlignment="Right" FontSize="10"
                                   Foreground="{DynamicResource SubTextBrush}" />
                    </Grid>
                    <TextBox x:Name="OutputBox" Grid.Row="3" Style="{StaticResource Input}" IsReadOnly="True"
                             Background="{DynamicResource InputBrush}" FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
