<Window x:Class="MCTL.Views.ModpackImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="460" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="导入整合包" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="FileText" Text="" FontSize="11" Margin="0,4,0,0"
                           Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,12,0,8">
                <TextBlock x:Name="StatusText" Text="将安装到当前游戏目录，并出现在游戏列表中。"
                           FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" />
                <StackPanel x:Name="ProgressHost" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock x:Name="PercentText" Text="0%" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <ProgressBar x:Name="Bar" Height="7" Minimum="0" Maximum="100" Margin="0,4,0,0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}"
                                 BorderThickness="0" />
                </StackPanel>
            </StackPanel>

            <TextBox x:Name="LogBox" Grid.Row="2" Style="{StaticResource Input}" IsReadOnly="True"
                     Background="{DynamicResource InputBrush}" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource Btn}" Padding="16,7"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="StartBtn" Content="开始导入" Style="{StaticResource PrimaryBtn}" Padding="18,7"
                        Click="Start_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
