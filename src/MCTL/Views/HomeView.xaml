<UserControl x:Class="MCTL.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:MCTL.Core"
             xmlns:controls="clr-namespace:MCTL.Controls">
    <Grid Margin="6,2,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,12">
            <StackPanel>
                <TextBlock x:Name="Greeting" Text="欢迎回来" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource HeadingBrush}" />
                <TextBlock x:Name="SubGreeting" Text="选择已安装的版本并启动游戏。" Margin="0,5,0,0"
                           FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
            </StackPanel>
            <ToggleButton x:Name="LogToggle" Style="{StaticResource ChipToggle}" Content="运行日志"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0"
                          Checked="LogToggle_Changed" Unchecked="LogToggle_Changed"
                          ToolTip="显示 / 隐藏运行日志" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- 左 1/3：固定启动模块 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 账号：3D 头像 + ID + 正版（无外框，右键可退出登录） -->
                        <StackPanel x:Name="AccountBlock" HorizontalAlignment="Center" Margin="0,4,0,14"
                                    ToolTip="右键可退出正版账号">
                            <StackPanel.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkMenu}">
                                    <MenuItem x:Name="LogoutMenu" Header="退出登录" Click="Logout_Click" />
                                </ContextMenu>
                            </StackPanel.ContextMenu>

                            <controls:Skin3DView x:Name="AccountHead" Width="120" Height="120"
                                                 HeadOnly="True" WalkAnimation="False"
                                                 HorizontalAlignment="Center" />

                            <TextBlock x:Name="AccountName" Text="未登录" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                       Margin="0,2,0,0" />
                            <TextBlock x:Name="AccountSub" Text="正版" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />

                            <Button x:Name="AccountBtn" Content="微软登录" Style="{StaticResource Btn}"
                                    Margin="0,10,0,0" Padding="16,6" HorizontalAlignment="Center"
                                    Click="Account_Click" />
                        </StackPanel>

                        <TextBlock Text="启动设置" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />

                        <TextBlock x:Name="PlayerNameLabel" Text="玩家名（离线模式）" FontSize="11" Margin="0,10,0,4"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <TextBox x:Name="PlayerNameBox" Style="{StaticResource Input}" Height="32" />

                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="内存分配" FontSize="11" Foreground="{DynamicResource SubTextBrush}" />
                            <TextBlock x:Name="MemoryText" HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{DynamicResource SubTextBrush}" />
                        </Grid>
                        <Slider x:Name="MemorySlider" Minimum="1" Maximum="32" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="MemorySlider_ValueChanged" />

                        <CheckBox x:Name="FullscreenBox" Content="全屏启动" Margin="0,10,0,0" />

                        <TextBlock Text="Java 运行时" Margin="0,10,0,4" FontSize="11" Foreground="{DynamicResource SubTextBrush}" />
                        <TextBlock x:Name="JavaText" Text="检测中…" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" MaxHeight="40" />
                        <CheckBox x:Name="JavaAutoChk" Content="自动选择 Java（按版本要求匹配）" Margin="0,6,0,0"
                                  Visibility="Collapsed" Checked="JavaAuto_Changed" Unchecked="JavaAuto_Changed" />
                        <ComboBox x:Name="JavaCombo" Margin="0,5,0,0" FontSize="11"
                                  SelectionChanged="JavaCombo_SelectionChanged" />

                        <Button x:Name="LaunchButton" Content="启 动 游 戏" Style="{StaticResource PrimaryBtn}"
                                Height="46" Margin="0,16,0,0" FontSize="13" Click="Launch_Click" />
                        <Button x:Name="KillButton" Content="结束游戏" Style="{StaticResource Btn}"
                                Height="32" Margin="0,8,0,0" Visibility="Collapsed" Click="Kill_Click" />

                        <Separator Margin="0,14,0,10" Background="{DynamicResource LineBrush}" />

                        <!-- 客户端名字按钮：点开右上角版本列表 -->
                        <Button x:Name="VersionButton" Content="选择版本" Style="{StaticResource Btn}" Height="34"
                                Click="VersionButton_Click" ToolTip="打开版本列表（Esc 关闭）" FontSize="12.5" />
                        <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="11.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="FolderHint" Margin="0,4,0,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" />

                        <Button x:Name="ModManagerButton" Content="模组管理" Style="{StaticResource Btn}" Height="32"
                                Margin="0,10,0,0" Click="ModManager_Click"
                                ToolTip="查看 / 启停 / 更新 / 删除当前版本的模组（Esc 关闭）" />

                        <TextBlock Text="快捷入口" FontSize="11" Margin="0,14,0,6"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <WrapPanel>
                            <Button Content="mods" Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,6,6"
                                    FontSize="11" Click="QuickMods_Click" />
                            <Button Content="资源包" Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,6,6"
                                    FontSize="11" Click="QuickResourcePacks_Click" />
                            <Button Content="光影" Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,6,6"
                                    FontSize="11" Click="QuickShaderPacks_Click" />
                            <Button Content="存档" Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,6,6"
                                    FontSize="11" Click="QuickSaves_Click" />
                        </WrapPanel>

                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="打开版本目录" Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,6,6"
                                    FontSize="11" Click="OpenInstanceDir_Click" />
                            <Button Content="刷新版本" Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,6,6"
                                    FontSize="11" Click="Refresh_Click" />
                            <Button Content="下载新内容" Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,6,6"
                                    FontSize="11" Click="GoDownload_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右 2/3：3D 皮肤预览 / 运行日志 -->
            <Grid Grid.Column="2">
                <Border x:Name="SkinCard" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock x:Name="SkinCardTitle" Text="皮肤预览" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubTextBrush}" />
                            <TextBlock x:Name="SkinCardMode" Text="经典 Classic" FontSize="10.5"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource SubTextBrush}" />
                        </Grid>
                        <controls:Skin3DView x:Name="BodySkinView" Grid.Row="1" Margin="0,8,0,8"
                                             HeadOnly="False" WalkAnimation="True" />
                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="SkinAuthorText" Text="作者：Xyu" FontSize="10.5"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"
                                       Foreground="{DynamicResource SubTextBrush}" />
                            <TextBlock Text="按住左键拖动旋转 · 滚轮缩放" FontSize="10.5"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="LogCard" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="运行日志" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <ListBox x:Name="LogList" Grid.Row="1" Style="{StaticResource DarkList}"
                                 ItemsSource="{x:Static core:Logger.Lines}" FontFamily="Consolas" FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 浮层：版本列表（右上）/ 模组管理（右侧全高） -->
            <Grid Grid.ColumnSpan="3">
                <!-- 版本列表 -->
                <Border x:Name="VersionPanel" Width="470" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Style="{StaticResource Card}" Visibility="Collapsed" RenderTransformOrigin="1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="版本列表" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource HeadingBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="新建文件夹" Style="{StaticResource Btn}" Padding="10,4" FontSize="11"
                                        Click="NewGameFolder_Click" ToolTip="在指定位置创建一个新的 .minecraft 文件夹" />
                                <Button Content="添加目录" Style="{StaticResource Btn}" Margin="6,0,0,0"
                                        Padding="10,4" FontSize="11" Click="AddFolder_Click" />
                                <Button Content="✕" Style="{StaticResource IconBtn}" Margin="8,0,0,0"
                                        Click="CloseVersionPanel_Click" ToolTip="关闭（Esc）" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="显示模式" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" />
                            <RadioButton x:Name="ModeAll" Style="{StaticResource Chip}" Content="综合" GroupName="vermode"
                                         Margin="8,0,6,0" Checked="VersionMode_Changed" />
                            <RadioButton x:Name="ModeSelected" Style="{StaticResource Chip}" Content="单独" GroupName="vermode"
                                         Checked="VersionMode_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="DirPanel" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed" />

                        <TextBox x:Name="ListSearch" Grid.Row="3" Style="{StaticResource Input}" Height="32" FontSize="11"
                                 Margin="0,10,0,0" TextChanged="ListSearch_Changed"
                                 ToolTip="搜索版本 / 加载器，例如 1.21、fabric、neoforge" />

                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <ListBox x:Name="VersionList" Style="{StaticResource DarkList}"
                                     ItemContainerStyle="{StaticResource DarkItem}" SelectionChanged="VersionList_SelectionChanged"
                                     MouseDoubleClick="VersionList_MouseDoubleClick"
                                     PreviewMouseRightButtonDown="VersionList_PreviewRightDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid AutomationProperties.Name="{Binding Id}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource ChipBrush}">
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkMenu}">
                                        <MenuItem Header="启动此版本" Click="MenuLaunch_Click" />
                                        <Separator />
                                        <MenuItem Header="设置版本图标…" Click="MenuIcon_Click" />
                                        <MenuItem Header="恢复默认图标" Click="MenuResetIcon_Click" />
                                        <Separator />
                                        <MenuItem Header="重命名版本…" Click="MenuRename_Click" />
                                        <MenuItem Header="删除版本…" Click="MenuDelete_Click" />
                                        <Separator />
                                        <MenuItem Header="导入整合包…" Click="MenuImport_Click" />
                                        <MenuItem Header="导出整合包…" Click="MenuExport_Click" />
                                        <MenuItem Header="打开版本文件夹" Click="MenuOpenFolder_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <TextBlock x:Name="EmptyHint" Text="还没有安装任何版本，去「下载」页安装一个吧。"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 模组管理：与版本列表一致的右侧全高面板 -->
                <Border x:Name="ModPanel" Width="470" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Style="{StaticResource Card}" Visibility="Collapsed" RenderTransformOrigin="1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock x:Name="ModPanelTitle" Text="模组管理" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource HeadingBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox x:Name="ModSelectModeChk" Content="选取模式" FontSize="11" VerticalAlignment="Center"
                                          Margin="0,0,10,0" Checked="ModSelectMode_Changed" Unchecked="ModSelectMode_Changed"
                                          ToolTip="开启后：按住鼠标左键上下拖动可连续多选；右键弹出批量操作菜单" />
                                <Button Content="刷新" Style="{StaticResource Btn}" Padding="10,4" FontSize="11"
                                        Click="ModRefresh_Click" />
                                <Button Content="✕" Style="{StaticResource IconBtn}" Margin="8,0,0,0"
                                        Click="CloseModPanel_Click" ToolTip="关闭（Esc）" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModSearchBox" Style="{StaticResource Input}" Height="32" FontSize="11"
                                     TextChanged="ModSearch_Changed" ToolTip="按中文名 / 英文名过滤" />
                            <TextBlock x:Name="ModSelectionText" Grid.Column="1" Margin="10,0,0,0" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                                       Text="已选择 0 个文件" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <ListBox x:Name="ModList" Style="{StaticResource DarkList}"
                                     ItemContainerStyle="{StaticResource DarkItem}" SelectionMode="Extended"
                                     SelectionChanged="ModList_SelectionChanged" FontSize="12"
                                     PreviewMouseLeftButtonDown="ModList_PreviewMouseLeftButtonDown"
                                     MouseMove="ModList_MouseMove"
                                     PreviewMouseLeftButtonUp="ModList_MouseLeftButtonUp"
                                     PreviewMouseRightButtonDown="ModList_PreviewRightDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid AutomationProperties.Name="{Binding DisplayName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="8" ClipToBounds="True"
                                                    Background="{DynamicResource ChipBrush}">
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" FontSize="10" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource SubTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="10"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkMenu}">
                                        <MenuItem Header="更新选中模组" Click="ModUpdate_Click" />
                                        <Separator />
                                        <MenuItem Header="启用选中模组" Click="ModEnable_Click" />
                                        <MenuItem Header="禁用选中模组" Click="ModDisable_Click" />
                                        <Separator />
                                        <MenuItem Header="打开模组所在文件夹" Click="ModOpenSelectedFolder_Click" />
                                        <MenuItem Header="删除选中模组…" Click="ModDelete_Click" />
                                        <Separator />
                                        <MenuItem Header="取消选择" Click="ModClearSelection_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>

                            <!-- 操作小窗 -->
                            <Border x:Name="ModActionPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,6,6" Padding="10" CornerRadius="12" Visibility="Collapsed"
                                    Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="ModActionHint" Text="已选择 0 个文件" FontSize="10"
                                               Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <Button Content="更新" Style="{StaticResource PrimaryBtn}" Padding="12,5"
                                                Margin="0,0,6,6" FontSize="11" Click="ModUpdate_Click" />
                                        <Button Content="启用" Style="{StaticResource Btn}" Padding="12,5"
                                                Margin="0,0,6,6" FontSize="11" Click="ModEnable_Click" />
                                        <Button Content="禁用" Style="{StaticResource Btn}" Padding="12,5"
                                                Margin="0,0,6,6" FontSize="11" Click="ModDisable_Click" />
                                        <Button Content="删除" Style="{StaticResource Btn}" Padding="12,5"
                                                Margin="0,0,6,6" FontSize="11" Click="ModDelete_Click" />
                                        <Button Content="取消选择" Style="{StaticResource Btn}" Padding="12,5"
                                                Margin="0,0,0,6" FontSize="11" Click="ModClearSelection_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock x:Name="ModStatusText" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="打开 mods 文件夹" Style="{StaticResource Btn}" Padding="10,5"
                                        Margin="0,0,6,0" FontSize="11" Click="ModOpenFolder_Click" />
                                <Button Content="从文件安装" Style="{StaticResource Btn}" Padding="10,5"
                                        Margin="0,0,6,0" FontSize="11" Click="ModInstallFromFile_Click" />
                                <Button Content="下载新模组" Style="{StaticResource PrimaryBtn}" Padding="12,5"
                                        FontSize="11" Click="ModGoDownload_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
