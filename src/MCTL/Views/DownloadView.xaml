<UserControl x:Class="MCTL.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="View_PreviewKeyDown"
             AllowDrop="True" DragOver="View_DragOver" Drop="View_Drop">
    <Grid Margin="6,2,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,12">
            <TextBlock Text="下载中心" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />
            <TextBlock x:Name="HeaderHint" Text="模组 / 光影 / 资源包 / 材质包来自 Modrinth，原版与加载器支持镜像加速。"
                       Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧分类 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" VerticalAlignment="Top">
                <StackPanel>
                    <RadioButton x:Name="NavMod" Style="{StaticResource DlNav}" Tag="🧩" Content="模组"
                                 GroupName="dlnav" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavModpack" Style="{StaticResource DlNav}" Tag="📦" Content="整合包"
                                 GroupName="dlnav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavVanilla" Style="{StaticResource DlNav}" Tag="🎮" Content="原版"
                                 GroupName="dlnav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavShader" Style="{StaticResource DlNav}" Tag="✨" Content="光影"
                                 GroupName="dlnav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavResourcePack" Style="{StaticResource DlNav}" Tag="🎨" Content="资源包"
                                 GroupName="dlnav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavTexturePack" Style="{StaticResource DlNav}" Tag="🧱" Content="材质包"
                                 GroupName="dlnav" Checked="Nav_Checked" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                <!-- 原版 / 加载器安装 -->
                <Border x:Name="VanillaPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="96" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBox x:Name="VersionSearch" Style="{StaticResource Input}"
                                     ToolTip="输入版本号筛选，例如 1.21" TextChanged="VersionSearch_TextChanged" />
                            <TextBlock x:Name="VersionSearchHint" Text="搜索版本号，例如 1.21"
                                       Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" IsHitTestVisible="False" />
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                            <ToggleButton x:Name="VerRelease" Style="{StaticResource ChipToggle}" Content="正式版"
                                          IsChecked="True" Checked="VersionCategory_Changed" Unchecked="VersionCategory_Changed" />
                            <ToggleButton x:Name="VerSnapshot" Style="{StaticResource ChipToggle}" Content="预览版"
                                          Checked="VersionCategory_Changed" Unchecked="VersionCategory_Changed" />
                            <ToggleButton x:Name="VerOld" Style="{StaticResource ChipToggle}" Content="远古版"
                                          Checked="VersionCategory_Changed" Unchecked="VersionCategory_Changed" />
                            <ToggleButton x:Name="VerApril" Style="{StaticResource ChipToggle}" Content="愚人节版"
                                          Checked="VersionCategory_Changed" Unchecked="VersionCategory_Changed" />
                        </WrapPanel>

                        <Border x:Name="VersionListHost" Grid.Row="2" Margin="0,4,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="2,0,0,2">
                                    <TextBlock x:Name="VersionHeader" Text="正式版" FontSize="11"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="双击版本可直接安装" FontSize="10" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                                </Grid>
                                <ListBox x:Name="VersionList" Grid.Row="1" Style="{StaticResource DarkList}"
                                         ItemContainerStyle="{StaticResource DarkItem}"
                                         SelectionChanged="VersionList_SelectionChanged"
                                         MouseDoubleClick="VersionList_MouseDoubleClick" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock Text="安装到" FontSize="11" Foreground="{DynamicResource SubTextBrush}" />
                            <WrapPanel x:Name="FolderPanel" Margin="0,6,0,0" />
                            <TextBlock x:Name="TargetText" FontSize="10" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <WrapPanel Grid.Row="4" Margin="0,10,0,0">
                            <Button x:Name="InstallVanillaBtn" Content="安装原版" Style="{StaticResource PrimaryBtn}"
                                    Padding="14,8" Margin="0,0,8,6" Click="InstallVanilla_Click" />
                            <Button x:Name="InstallFabricBtn" Content="安装 Fabric" Style="{StaticResource Btn}"
                                    Padding="14,8" Margin="0,0,8,6" Click="InstallFabric_Click" />
                            <Button x:Name="InstallForgeBtn" Content="安装 Forge" Style="{StaticResource Btn}"
                                    Padding="14,8" Margin="0,0,8,6" Click="InstallForge_Click" />
                            <Button x:Name="InstallNeoForgeBtn" Content="安装 NeoForge" Style="{StaticResource Btn}"
                                    Padding="14,8" Margin="0,0,8,6" Click="InstallNeoForge_Click" />
                            <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource Btn}" Padding="12,8"
                                    Margin="0,0,0,6" IsEnabled="False" Click="Cancel_Click" />
                        </WrapPanel>

                        <TextBox x:Name="InstallLog" Grid.Row="5" Margin="0,8,0,0" Style="{StaticResource Input}"
                                 IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </Grid>
                </Border>

                <!-- Modrinth 资源 -->
                <Border x:Name="ModPanel" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModSearch" Grid.Column="0" Style="{StaticResource Input}"
                                     ToolTip="搜索 Modrinth，留空则显示热门" KeyDown="ModSearch_KeyDown" />
                            <Button Grid.Column="1" Content="搜索" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                    Padding="16,6" Click="SearchMods_Click" />
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="游戏版本" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" />
                            <ComboBox x:Name="ModGameVersionCombo" Width="150" Margin="8,0,16,0" FontSize="11"
                                      SelectionChanged="ModFilter_Changed" />
                            <TextBlock Text="加载器" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" />
                            <ComboBox x:Name="ModLoaderCombo" Width="118" Margin="8,0,0,0" FontSize="11"
                                      SelectionChanged="ModLoader_Changed" />
                            <TextBlock x:Name="ModFilterHint" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <WrapPanel x:Name="CategoryPanel" Grid.Row="0" Margin="0,2,0,0" />
                            <WrapPanel x:Name="SortPanel" Grid.Row="1" />

                            <Grid Grid.Row="2" Margin="0,2,0,4">
                                <TextBlock x:Name="ModHeader" Text="热门内容（按下载量）" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="PrevPageBtn" Content="上一页" Style="{StaticResource Btn}"
                                            Padding="10,3" FontSize="11" Click="PrevPage_Click" />
                                    <TextBlock x:Name="PageText" Text="1/1" FontSize="11" Margin="8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                    <Button x:Name="NextPageBtn" Content="下一页" Style="{StaticResource Btn}"
                                            Padding="10,3" FontSize="11" Click="NextPage_Click" />
                                </StackPanel>
                            </Grid>

                            <ListBox x:Name="ModList" Grid.Row="3" Style="{StaticResource DarkList}"
                                     ItemContainerStyle="{StaticResource DarkItem}" FontSize="12"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="ModList_MouseDoubleClick">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid AutomationProperties.Name="{Binding Title}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource ChipBrush}">
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource AccentSoftBrush}"
                                                            CornerRadius="4" Padding="4,0" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="10"
                                                               ToolTip="{Binding OriginalDescription}"
                                                               Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <TextBlock Text="{Binding Downloads}" FontSize="9.5" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource SubTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Grid.Row="4" Margin="0,8,0,0">
                                <TextBlock Text="双击下载；可把 .jar 直接拖进本页安装到当前版本的 mods" FontSize="11"
                                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="McmodBtn" Content="在 MCmod 搜索" Style="{StaticResource Btn}"
                                            Padding="12,6" Margin="0,0,8,0" Visibility="Collapsed" Click="Mcmod_Click"
                                            ToolTip="两个平台都搜不到时，去 MCmod 网页搜索" />
                                    <Button Content="打开文件夹" Style="{StaticResource Btn}" Padding="12,6" Click="OpenMods_Click" />
                                    <Button Content="下载所选" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"
                                            Padding="16,6" Click="DownloadMod_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <!-- 共用进度 / 状态（原版与 Modrinth 面板都显示） -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel x:Name="ProgressHost" Visibility="Collapsed" Margin="0,0,0,5">
                        <TextBlock x:Name="PercentText" Text="0%" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" />
                        <ProgressBar x:Name="Bar" Height="7" Minimum="0" Maximum="100" Margin="0,4,0,0"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}"
                                     BorderThickness="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <Button x:Name="DetailBtn" Grid.Column="1" Content="详情" Style="{StaticResource Btn}"
                                VerticalAlignment="Top" Margin="8,0,0,0" Padding="8,2" FontSize="11"
                                Click="Detail_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
