<Window x:Class="MCTL.Views.VersionNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="376" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" Text="安装版本" FontSize="15" FontWeight="SemiBold"
                       MouseLeftButtonDown="Header_MouseDown" />

            <TextBlock x:Name="LocationLabel" Grid.Row="1" Text="安装位置（游戏目录）" FontSize="11" Margin="0,16,0,6"
                       Foreground="{DynamicResource SubTextBrush}" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="DirCombo" Grid.Column="0" Height="32" FontSize="11" />
                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Btn}" Margin="8,0,0,0"
                        Padding="12,4" Click="Browse_Click" />
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="NameLabel" Text="版本名称（只改显示名与文件夹名，仍装在上面选的目录里）" FontSize="11" Margin="0,0,0,6"
                           Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                <TextBox x:Name="NameBox" Style="{StaticResource Input}" Height="32" FontSize="11" />
                <TextBlock x:Name="PathHint" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubTextBrush}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="4" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="OrangeRed" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="取消" Style="{StaticResource Btn}" Padding="18,7" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="开始安装" Style="{StaticResource PrimaryBtn}" Padding="18,7" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
