<UserControl x:Class="AuroraLauncher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6,2,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,0,14">
            <StackPanel>
                <TextBlock Text="游戏库" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />
                <TextBlock Text="添加程序路径，一键启动。"
                           Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
            </StackPanel>
            <Button Content="+ 添加应用" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Padding="18,9" Click="Add_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="AppsPanel" />
        </ScrollViewer>
    </Grid>
</UserControl>
