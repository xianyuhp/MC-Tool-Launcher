<UserControl x:Class="AuroraLauncher.Views.SteamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6,2,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,0,14">
            <StackPanel>
                <TextBlock Text="Steam 游戏" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />
                <TextBlock Text="默认展示正在折扣的热销游戏；搜索后右侧显示各版本与价格（数据来自 Steam 商店）。"
                           Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Width="360" KeyDown="SearchBox_KeyDown" />
                    <Button Content="搜索游戏" Style="{StaticResource PrimaryBtn}" Margin="10,0,0,0"
                            Padding="18,8" Click="Search_Click" />
                    <TextBlock x:Name="SearchStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ListBox x:Name="Results" Style="{StaticResource DarkList}"
                         ItemContainerStyle="{StaticResource DarkItem}" SelectionChanged="Results_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid AutomationProperties.Name="{Binding Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="64" Height="30" CornerRadius="6" Background="{DynamicResource ChipBrush}" ClipToBounds="True">
                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PriceText}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource PriceBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Height="150" CornerRadius="12" Background="{DynamicResource ChipBrush}" ClipToBounds="True">
                            <Image x:Name="DetailImage" Source="{Binding Image}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock x:Name="DetailName" Text="搜索一个游戏开始" FontSize="17" FontWeight="SemiBold"
                                   Margin="0,14,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailId" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,4,0,0" />

                        <TextBlock Text="版本" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,14,0,4" />
                        <ListBox x:Name="EditionList" Height="118" Style="{StaticResource DarkList}"
                                 ItemContainerStyle="{StaticResource DarkItem}" FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Price}" FontSize="11" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource PriceBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="国区价格" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,16,0,4" />
                        <TextBlock x:Name="DetailPrice" Text="—" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PriceBrush}" />
                        <TextBlock Text="历史最低价" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,14,0,4" />
                        <TextBlock x:Name="DetailLow" Text="—" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PriceBrush}" />
                        <TextBlock x:Name="DetailSource" Text="" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <TextBlock Text="史低优先取 SteamDB 国区实时数据，不可用时按实时汇率折算 CheapShark 国际史低。"
                                   FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="打开商店页" Style="{StaticResource PrimaryBtn}" Padding="16,8" Click="OpenStore_Click" />
                            <Button Content="重新查询" Style="{StaticResource Btn}" Margin="8,0,0,0" Padding="14,8" Click="RefreshPrice_Click" />
                        </StackPanel>
                        <TextBlock x:Name="DetailStatus" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <TextBlock Text="提示：国区搜索接口偶尔不可用，已自动回退美区搜索；价格始终按国区查询。"
                                   FontSize="10" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
