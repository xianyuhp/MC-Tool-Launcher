<UserControl x:Class="AuroraLauncher.Views.ServerHelperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="View_DragOver" Drop="View_Drop">
    <Grid Margin="6,2,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,8">
            <TextBlock Text="开服" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />
            <TextBlock Text="先选择核心类型与版本下载服务端，然后用可视化面板配置并启动服务器。"
                       Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
        </StackPanel>

        <!-- 子选项：下载核心 / 启动服务端 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,0,10">
            <RadioButton x:Name="TabDownload" Style="{StaticResource Chip}" Content="下载 / 更新核心"
                         GroupName="servertab" IsChecked="True" Checked="ServerTab_Changed" />
            <RadioButton x:Name="TabRun" Style="{StaticResource Chip}" Content="启动服务端"
                         GroupName="servertab" Checked="ServerTab_Changed" />
        </StackPanel>

        <!-- 下载核心 -->
        <Grid x:Name="DownloadTab" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="服务端核心" FontSize="12.5" FontWeight="SemiBold" />

                    <WrapPanel x:Name="CorePanel" Grid.Row="1" Margin="0,10,0,0" />

                    <StackPanel Grid.Row="2" Margin="0,4,0,0">
                        <Grid>
                            <TextBlock Text="游戏版本" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" />
                            <ComboBox x:Name="CoreVersionCombo" Width="170" HorizontalAlignment="Right"
                                      FontSize="11" SelectionChanged="CoreVersion_Changed" />
                        </Grid>
                        <TextBlock x:Name="CoreVersionHint" Text="" FontSize="10" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="保存到" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="选择根目录" Style="{StaticResource Btn}" Padding="10,5"
                                    Click="PickServerDir_Click" />
                            <Button Content="打开" Style="{StaticResource Btn}" Padding="10,5" Margin="8,0,0,0"
                                    Click="OpenServerDir_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ServerDirText" Grid.Row="4" Text="—" FontSize="10" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubTextBrush}" />

                    <WrapPanel Grid.Row="5" Margin="0,10,0,0">
                        <Button x:Name="DownloadServerBtn" Content="下载服务端" Style="{StaticResource PrimaryBtn}"
                                Padding="14,7" Margin="0,0,8,6" Click="DownloadServer_Click" />
                        <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource Btn}" Padding="12,7"
                                Margin="0,0,8,6" IsEnabled="False" Click="Cancel_Click" />
                        <Button Content="打开 server 目录" Style="{StaticResource Btn}" Padding="12,7"
                                Margin="0,0,0,6" Click="OpenServerRoot_Click" />
                    </WrapPanel>

                    <StackPanel Grid.Row="6" Margin="0,4,0,0">
                        <StackPanel x:Name="ServerProgressHost" Visibility="Collapsed">
                            <TextBlock x:Name="PercentText" Text="0%" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" />
                            <ProgressBar x:Name="Bar" Height="7" Minimum="0" Maximum="100" Margin="0,5,0,0"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}"
                                         BorderThickness="0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <TextBox x:Name="InstallLog" Style="{StaticResource Input}" IsReadOnly="True"
                                 Background="{DynamicResource InputBrush}" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,8,0,0"
                                 Height="70" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="插件下载（Modrinth）" FontSize="12.5" FontWeight="SemiBold" />

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PluginServerCombo" Grid.Column="0" Width="124" FontSize="11"
                                  SelectionChanged="PluginFilter_Changed" />
                        <ComboBox x:Name="PluginVersionCombo" Grid.Column="1" Width="112" FontSize="11"
                                  Margin="8,0,0,0" SelectionChanged="PluginFilter_Changed" />
                        <TextBox x:Name="PluginSearch" Grid.Column="2" Style="{StaticResource Input}"
                                 Margin="8,0,0,0" ToolTip="搜索插件，留空显示热门" KeyDown="PluginSearch_KeyDown" />
                        <Button Grid.Column="3" Content="搜索" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                Padding="14,6" Click="SearchPlugins_Click" />
                    </Grid>

                    <WrapPanel x:Name="PluginCategoryPanel" Grid.Row="2" Margin="0,8,0,0" />

                    <Grid Grid.Row="3" Margin="0,2,0,4">
                        <TextBlock x:Name="PluginHeader" Text="热门插件" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="PrevPageBtn" Content="上一页" Style="{StaticResource Btn}"
                                    Padding="10,3" FontSize="11" Click="PrevPage_Click" />
                            <TextBlock x:Name="PageText" Text="1/1" FontSize="11" Margin="8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" />
                            <Button x:Name="NextPageBtn" Content="下一页" Style="{StaticResource Btn}"
                                    Padding="10,3" FontSize="11" Click="NextPage_Click" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="PluginList" Grid.Row="4" Style="{StaticResource DarkList}"
                             ItemContainerStyle="{StaticResource DarkItem}" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="PluginList_MouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid AutomationProperties.Name="{Binding Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ChipBrush}">
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="4" Padding="4,0" Margin="0,0,5,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="10"
                                                       ToolTip="{Binding OriginalDescription}"
                                                       Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <TextBlock Text="{Binding Downloads}" FontSize="9.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <TextBlock Text="缺少的前置插件会自动安装" FontSize="10"
                                   Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="打开插件目录" Style="{StaticResource Btn}" Padding="10,5"
                                    Click="OpenPluginsDir_Click" />
                            <Button Content="下载所选" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"
                                    Padding="14,5" Click="DownloadPlugin_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 启动服务端 -->
        <Grid x:Name="RunTab" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="服务端实例" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="下载时可选择保存位置并自定义实例名称；默认保存在启动器目录 server 下，每个实例单独一个文件夹。"
                                   FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,6">
                        <Button Content="刷新" Style="{StaticResource Btn}" Padding="12,5" Click="RefreshInstances_Click" />
                        <Button Content="打开 server 目录" Style="{StaticResource Btn}" Padding="12,5" Margin="8,0,0,0"
                                Click="OpenServerRoot_Click" />
                    </StackPanel>

                    <ListBox x:Name="InstanceList" Grid.Row="2" Style="{StaticResource DarkList}"
                             ItemContainerStyle="{StaticResource DarkItem}" FontSize="12"
                             SelectionChanged="Instance_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Note}" FontSize="10" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="打开实例目录" Style="{StaticResource Btn}" Padding="12,5"
                                Click="OpenInstanceDir_Click" />
                        <Button Content="后台窗口" Style="{StaticResource Btn}" Padding="12,5" Margin="8,0,0,0"
                                Click="OpenConsole_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="开服设置" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="保存服务器配置" Style="{StaticResource Btn}" Padding="12,5"
                                    Click="SaveProperties_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Java 运行时" FontSize="10" Foreground="{DynamicResource SubTextBrush}" />
                            <ComboBox x:Name="ServerJavaCombo" Margin="0,5,0,0" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <TextBlock Text="内存分配" FontSize="10" Foreground="{DynamicResource SubTextBrush}" />
                                <TextBlock x:Name="ServerMemoryText" HorizontalAlignment="Right" FontSize="10"
                                           Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>
                            <Slider x:Name="ServerMemorySlider" Minimum="1" Maximum="32" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="ServerMemory_Changed" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="定时重启" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <TextBox x:Name="RestartBox" Style="{StaticResource Input}" Width="56" Height="32"
                                 FontSize="11" TextAlignment="Center" Margin="8,0,4,0" Text="0" />
                        <TextBlock Text="分钟（0 = 关闭）" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>

                    <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button Content="启动服务端" Style="{StaticResource PrimaryBtn}" Padding="16,7"
                                Margin="0,0,8,6" Click="StartServer_Click" />
                        <Button Content="停止" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,6"
                                Click="StopServer_Click" />
                        <Button Content="后台窗口" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,0,6"
                                Click="OpenConsole_Click" />
                    </WrapPanel>

                    <TextBlock Grid.Row="4" Text="服务器配置 · server.properties" FontSize="12" FontWeight="SemiBold"
                               Margin="0,8,0,4" />
                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PropertyPanel" />
                    </ScrollViewer>

                    <TextBlock x:Name="RunHint" Grid.Row="6" Text="" FontSize="10" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
