<Window x:Class="AuroraLauncher.Views.DownloadDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="780" Height="560" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize" KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="下载详情" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="StartedText" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource SubTextBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock x:Name="StatusText" Text="准备中…" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubTextBrush}" />
                <TextBlock x:Name="FileText" Text="" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SubTextBrush}" />
                <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Margin="0,10,0,0"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ChipBrush}" BorderThickness="0" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="任务日志" FontSize="12" Margin="0,16,0,6"
                       Foreground="{DynamicResource SubTextBrush}" />

            <Border Grid.Row="3" Background="{DynamicResource InputBrush}" CornerRadius="10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <ListBox x:Name="LogList" Style="{StaticResource DarkList}" ItemContainerStyle="{StaticResource DarkItem}"
                         FontFamily="Consolas" FontSize="11" Margin="6" />
            </Border>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Button x:Name="OpenFolderBtn" Content="打开游戏目录" Style="{StaticResource Btn}"
                        HorizontalAlignment="Left" Padding="14,7" Click="OpenFolder_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="取消任务" Style="{StaticResource Btn}"
                            Padding="16,7" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="关闭" Style="{StaticResource PrimaryBtn}" Padding="18,7" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

