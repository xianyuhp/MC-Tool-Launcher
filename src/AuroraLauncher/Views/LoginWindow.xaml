<Window x:Class="AuroraLauncher.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微软正版登录" Width="540" Height="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">

    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" MouseLeftButtonDown="Header_MouseDown">
                <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="M" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="微软正版登录" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="使用 Microsoft 账号登录，支持正版服务器与皮肤" FontSize="11"
                               Foreground="{DynamicResource SubTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="0,18,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}"
                       Text="浏览器会自动打开登录页；如果没有自动打开，请访问下方地址并输入代码。" />

            <Border Grid.Row="2" Margin="0,16,0,0" Background="{DynamicResource InputBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="登录代码" FontSize="11" Foreground="{DynamicResource SubTextBrush}" />
                    <TextBox x:Name="CodeText" Text="······" IsReadOnly="True" Background="Transparent"
                             BorderThickness="0" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"
                             HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="LinkText" Text="—" FontSize="11" Margin="0,6,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Margin="0,16,0,0">
                <TextBlock x:Name="StatusText" Text="正在获取登录代码…" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,12" />
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="打开登录页面" Style="{StaticResource Btn}" Padding="14,7"
                                Click="OpenLink_Click" />
                        <Button Content="复制代码" Style="{StaticResource Btn}" Margin="8,0,0,0" Padding="14,7"
                                Click="CopyCode_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource Btn}" Padding="18,7" Margin="0,0,8,0" Click="Cancel_Click" />
                        <Button Content="重新获取代码" Style="{StaticResource PrimaryBtn}" Padding="16,7" Click="Restart_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>

