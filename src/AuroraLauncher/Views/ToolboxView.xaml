<UserControl x:Class="AuroraLauncher.Views.ToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6,2,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,12">
            <TextBlock Text="工具箱" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />
            <TextBlock Text="常用目录、存档备份、日志清理与运行环境诊断（均指向当前选择的版本）。" Margin="0,6,0,0"
                       FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <Border Style="{StaticResource Card}" Background="#1A5B8CFF">
                    <StackPanel>
                        <TextBlock Text="当前版本文件夹" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="InstanceHint" Text="" FontSize="10" Margin="0,6,0,0"
                                   Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="版本目录" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="OpenGameDir_Click" />
                            <Button Content="mods" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="OpenMods_Click" />
                            <Button Content="资源包" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="OpenResourcePacks_Click" />
                            <Button Content="光影包" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="OpenShaderPacks_Click" />
                            <Button Content="存档" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="OpenSaves_Click" />
                            <Button Content="崩溃报告" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="OpenCrashReports_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Background="#1A22C7A9">
                    <StackPanel>
                        <TextBlock Text="维护工具" FontSize="13" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="备份存档" Style="{StaticResource PrimaryBtn}" Padding="14,7" Margin="0,0,8,8" Click="BackupSaves_Click" />
                            <Button Content="使用备份存档" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="RestoreSaves_Click" />
                            <Button Content="清理游戏日志" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="CleanLogs_Click" />
                            <Button Content="打开配置目录" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="OpenConfig_Click" />
                            <Button Content="打开图片目录" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="OpenImages_Click" />
                            <Button Content="打开音频目录" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="OpenAudio_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Background="#1A8B5CF6">
                    <StackPanel>
                        <TextBlock Text="诊断与导出" FontSize="13" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="重新检测 Java" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="DetectJava_Click" />
                            <Button Content="导出启动器日志" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="ExportLog_Click" />
                            <Button Content="打开安装器缓存" Style="{StaticResource Btn}" Padding="14,7" Margin="0,0,8,8" Click="OpenInstallers_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="ResultText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="操作记录" FontSize="12" Margin="0,0,0,6"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <TextBox x:Name="OutputBox" Height="140" Style="{StaticResource Input}" IsReadOnly="True"
                                 Background="{DynamicResource InputBrush}" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
