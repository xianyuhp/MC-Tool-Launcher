<Window x:Class="AuroraLauncher.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="196" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="输入" FontSize="13" FontWeight="SemiBold" />
            <TextBlock x:Name="HintText" Grid.Row="1" Text="" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
            <TextBox x:Name="InputBox" Grid.Row="2" Style="{StaticResource Input}" Margin="0,12,0,0"
                     VerticalAlignment="Top" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Btn}" Padding="18,7" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="确定" Style="{StaticResource PrimaryBtn}" Padding="18,7" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

