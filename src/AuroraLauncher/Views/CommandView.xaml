<UserControl x:Class="AuroraLauncher.Views.CommandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6,2,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,8">
            <TextBlock Text="指令生成" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />
            <TextBlock Text="按版本自动适配物品 NBT / 数据组件与实体装备格式，生成可用的 /give、/summon 及全部原版指令。"
                       Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="4,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="游戏版本" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubTextBrush}" />
            <ComboBox x:Name="VersionCombo" Grid.Column="1" Width="190" FontSize="11" Margin="8,0,14,0"
                      SelectionChanged="Version_Changed" />
            <TextBlock x:Name="VersionHint" Grid.Column="2" FontSize="10" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,10">
                <RadioButton x:Name="TabGive" Style="{StaticResource Chip}" Content="give 物品"
                             GroupName="cmdtabs" IsChecked="True" Checked="Tab_Changed" />
                <RadioButton x:Name="TabSummon" Style="{StaticResource Chip}" Content="summon 生物"
                             GroupName="cmdtabs" Checked="Tab_Changed" />
                <RadioButton x:Name="TabCatalog" Style="{StaticResource Chip}" Content="全部指令"
                             GroupName="cmdtabs" Checked="Tab_Changed" />
            </StackPanel>

            <!-- give -->
            <Grid x:Name="GivePanel" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="ItemSearch" Style="{StaticResource Input}" Height="32" FontSize="11"
                                 TextChanged="ItemSearch_Changed" ToolTip="搜索物品 ID，例如 diamond" />
                        <ListBox x:Name="ItemList" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource DarkList}"
                                 ItemContainerStyle="{StaticResource DarkItem}" FontSize="11"
                                 SelectionChanged="Item_Selected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="5" Background="{DynamicResource ChipBrush}"
                                                ClipToBounds="True">
                                            <Image Source="{Binding Icon}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Id}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Name}" FontSize="9.5" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource ChipBrush}"
                                    ClipToBounds="True">
                                <Image x:Name="GiveIcon" Stretch="Uniform" />
                            </Border>
                            <TextBlock x:Name="GiveSelected" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="目标（@p / @a / 玩家名）" FontSize="10"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBox x:Name="GiveTarget" Style="{StaticResource Input}" Height="32" FontSize="11"
                                                 Text="@p" TextChanged="OptionText_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="数量" FontSize="10" Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBox x:Name="GiveCount" Style="{StaticResource Input}" Height="32" FontSize="11"
                                                 Text="1" TextChanged="OptionText_Changed" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="自定义名称" FontSize="10" Margin="0,10,0,4"
                                           Foreground="{DynamicResource SubTextBrush}" />
                                <TextBox x:Name="GiveName" Style="{StaticResource Input}" Height="32" FontSize="11"
                                         TextChanged="OptionText_Changed" />

                                <TextBlock Text="描述文字（每行一条 Lore）" FontSize="10" Margin="0,10,0,4"
                                           Foreground="{DynamicResource SubTextBrush}" />
                                <TextBox x:Name="GiveLore" Style="{StaticResource Input}" Height="56" FontSize="11"
                                         AcceptsReturn="True" TextWrapping="Wrap" TextChanged="OptionText_Changed" />

                                <Grid Margin="0,10,0,4">
                                    <TextBlock Text="附魔" FontSize="10" Foreground="{DynamicResource SubTextBrush}" />
                                    <Button Content="+ 添加附魔" Style="{StaticResource Btn}" HorizontalAlignment="Right"
                                            Padding="8,2" FontSize="10" Click="AddEnchant_Click" />
                                </Grid>
                                <StackPanel x:Name="EnchantPanel" />

                                <CheckBox x:Name="UnbreakableChk" Content="无法破坏（Unbreakable）" FontSize="11"
                                          Margin="0,8,0,0" Checked="Option_Changed" Unchecked="Option_Changed" />

                                <Grid Margin="0,10,0,4">
                                    <TextBlock Text="属性修饰（盔甲值 / 攻击力 / 最大生命…）" FontSize="10"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                    <Button Content="+ 添加属性" Style="{StaticResource Btn}" HorizontalAlignment="Right"
                                            Padding="8,2" FontSize="10" Click="AddGiveAttribute_Click" />
                                </Grid>
                                <StackPanel x:Name="GiveAttributePanel" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="生成的指令" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubTextBrush}" />
                                <Button Content="复制" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right"
                                        Padding="14,4" FontSize="11" Click="Copy_Click" />
                            </Grid>
                            <TextBox x:Name="GiveOutput" Style="{StaticResource Input}" Height="64" Margin="0,6,0,0"
                                     IsReadOnly="True" FontFamily="Consolas" FontSize="11" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- summon -->
            <Grid x:Name="SummonPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="MobSearch" Style="{StaticResource Input}" Height="32" FontSize="11"
                                 TextChanged="MobSearch_Changed" ToolTip="搜索生物 ID，例如 zombie" />
                        <ListBox x:Name="MobList" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource DarkList}"
                                 ItemContainerStyle="{StaticResource DarkItem}" FontSize="11"
                                 SelectionChanged="Mob_Selected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="5" Background="{DynamicResource ChipBrush}"
                                                ClipToBounds="True">
                                            <Image Source="{Binding Icon}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Id}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Name}" FontSize="9.5" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource SubTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource ChipBrush}"
                                    ClipToBounds="True">
                                <Image x:Name="MobIcon" Stretch="Uniform" />
                            </Border>
                            <TextBlock x:Name="MobSelected" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="坐标（x y z）" FontSize="10" Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBox x:Name="SummonPos" Style="{StaticResource Input}" Height="32" FontSize="11"
                                                 Text="~ ~ ~" TextChanged="OptionText_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="生命值（可空）" FontSize="10" Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBox x:Name="SummonHealth" Style="{StaticResource Input}" Height="32" FontSize="11"
                                                 TextChanged="OptionText_Changed" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="自定义名称" FontSize="10" Margin="0,10,0,4"
                                           Foreground="{DynamicResource SubTextBrush}" />
                                <TextBox x:Name="SummonName" Style="{StaticResource Input}" Height="32" FontSize="11"
                                         TextChanged="OptionText_Changed" />

                                <CheckBox x:Name="PersistenceChk" Content="持久化（PersistenceRequired）" FontSize="11"
                                          Margin="0,8,0,0" IsChecked="True"
                                          Checked="SummonOption_Changed" Unchecked="SummonOption_Changed" />

                                <TextBlock x:Name="EquipmentLabel" Text="装备（1.21.5+ 使用 equipment 组件）" FontSize="10"
                                           Margin="0,10,0,4" Foreground="{DynamicResource SubTextBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="主手" FontSize="10" Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBox x:Name="MainHandBox" Style="{StaticResource Input}" Height="32" FontSize="11"
                                                 TextChanged="OptionText_Changed" />
                                        <TextBlock Text="头盔" FontSize="10" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBox x:Name="HeadBox" Style="{StaticResource Input}" Height="32" FontSize="11"
                                                 TextChanged="OptionText_Changed" />
                                        <TextBlock Text="护腿" FontSize="10" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBox x:Name="LegsBox" Style="{StaticResource Input}" Height="32" FontSize="11"
                                                 TextChanged="OptionText_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="副手" FontSize="10" Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBox x:Name="OffHandBox" Style="{StaticResource Input}" Height="32" FontSize="11"
                                                 TextChanged="OptionText_Changed" />
                                        <TextBlock Text="胸甲" FontSize="10" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBox x:Name="ChestBox" Style="{StaticResource Input}" Height="32" FontSize="11"
                                                 TextChanged="OptionText_Changed" />
                                        <TextBlock Text="靴子" FontSize="10" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBox x:Name="FeetBox" Style="{StaticResource Input}" Height="32" FontSize="11"
                                                 TextChanged="OptionText_Changed" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,4">
                                    <TextBlock Text="属性（盔甲值 / 攻击力 / 移动速度…）" FontSize="10"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                    <Button Content="+ 添加属性" Style="{StaticResource Btn}" HorizontalAlignment="Right"
                                            Padding="8,2" FontSize="10" Click="AddSummonAttribute_Click" />
                                </Grid>
                                <StackPanel x:Name="SummonAttributePanel" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="生成的指令" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubTextBrush}" />
                                <Button Content="复制" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right"
                                        Padding="14,4" FontSize="11" Click="CopySummon_Click" />
                            </Grid>
                            <TextBox x:Name="SummonOutput" Style="{StaticResource Input}" Height="64" Margin="0,6,0,0"
                                     IsReadOnly="True" FontFamily="Consolas" FontSize="11" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 全部指令 -->
            <Grid x:Name="CatalogPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="CatalogSearch" Style="{StaticResource Input}" Height="32" FontSize="11"
                                 TextChanged="CatalogSearch_Changed" ToolTip="搜索指令，例如 effect" />
                        <ListBox x:Name="CatalogList" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource DarkList}"
                                 ItemContainerStyle="{StaticResource DarkItem}" FontSize="11"
                                 SelectionChanged="Catalog_Selected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" FontSize="9.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CatalogTitle" Text="选择一条指令" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HeadingBrush}" />
                            <TextBlock x:Name="CatalogHint" Text="" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubTextBrush}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CatalogFields" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="生成的指令" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubTextBrush}" />
                                <Button Content="复制" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right"
                                        Padding="14,4" FontSize="11" Click="CopyCatalog_Click" />
                            </Grid>
                            <TextBox x:Name="CatalogOutput" Style="{StaticResource Input}" Height="64" Margin="0,6,0,0"
                                     IsReadOnly="True" FontFamily="Consolas" FontSize="11" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
