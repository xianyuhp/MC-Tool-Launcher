<Window x:Class="AuroraLauncher.Views.LoaderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="480" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock x:Name="TitleText" Text="选择版本" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="HintText" Grid.Row="1" Text="" FontSize="11" Margin="0,6,0,10"
                       Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
            <ListBox x:Name="VersionList" Grid.Row="2" Style="{StaticResource DarkList}"
                     ItemContainerStyle="{StaticResource DarkItem}" FontSize="12"
                     MouseDoubleClick="VersionList_MouseDoubleClick" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Style="{StaticResource Btn}" Padding="18,7" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="确定" Style="{StaticResource PrimaryBtn}" Padding="18,7" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

