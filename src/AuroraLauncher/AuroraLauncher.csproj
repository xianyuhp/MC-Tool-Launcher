<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MCTL</AssemblyName>
    <RootNamespace>AuroraLauncher</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Version>1.32.1</Version>
    <Product>MC Tool Launcher</Product>
    <Company>Aurora</Company>
    <FileVersion>1.32.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 模组中文名种子表（由 PCL 公开的 MC 百科条目数据整理而来） -->
    <EmbeddedResource Include="Core\Mods\modnames.seed.json" />
    <!-- 界面标题栏使用的图标（exe 图标由 ApplicationIcon 指定） -->
    <Resource Include="app.ico" />
    <!-- 内置默认皮肤，首次启动无需联网即可用正确贴图建模 -->
    <EmbeddedResource Include="Assets\default-skin.png" />
  </ItemGroup>

  <!--
    正式版：如果本地存在 ApiKeys.local.json（已在 .gitignore 中忽略，不会提交），
    就把其中的 API 凭据编进程序，构建出来的是无需配置的正式版；
    没有这个文件时构建的是开源版本，启动会提示使用者自己填写。
  -->
  <ItemGroup Condition="Exists('ApiKeys.local.json')">
    <EmbeddedResource Include="ApiKeys.local.json" LogicalName="AuroraLauncher.ApiKeys.local.json" />
  </ItemGroup>

</Project>

