<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MCTL</AssemblyName>
    <RootNamespace>AuroraLauncher</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Version>1.34.1</Version>
    <Product>MC Tool Launcher</Product>
    <Company>Aurora</Company>
    <FileVersion>1.34.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 模组中文名种子表（由 PCL 公开的 MC 百科条目数据整理而来） -->
    <EmbeddedResource Include="Core\Mods\modnames.seed.json" />
    <!-- 界面标题栏使用的图标（exe 图标由 ApplicationIcon 指定） -->
    <Resource Include="app.ico" />
    <!-- 内置默认皮肤，首次启动无需联网即可用正确贴图建模 -->
    <EmbeddedResource Include="Assets\default-skin.png" />
  </ItemGroup>

  <!--
    正式版：先运行 tools/KeyPacker 把 ApiKeys.local.json 打包成 ApiKeys.local.bin
    （AES-256-CBC + 掩码 + 分段重排，程序里读不到明文凭据），构建时再把它编进程序。
    两个文件都已在 .gitignore 中忽略；没有 .bin 时构建的是开源版本，启动提示使用者自己填写。
  -->
  <ItemGroup Condition="Exists('ApiKeys.local.bin')">
    <EmbeddedResource Include="ApiKeys.local.bin" LogicalName="AuroraLauncher.ApiKeys.local.bin" />
  </ItemGroup>

  <!-- 凭据文件比打包结果新（或还没打包）时，构建前自动重新打包 -->
  <Target Name="PackApiKeysPayload" BeforeTargets="PrepareResources"
          Inputs="ApiKeys.local.json" Outputs="ApiKeys.local.bin"
          Condition="Exists('ApiKeys.local.json')">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\..\tools\KeyPacker\KeyPacker.csproj&quot; -c Release -- &quot;$(MSBuildProjectDirectory)\ApiKeys.local.json&quot; &quot;$(MSBuildProjectDirectory)\ApiKeys.local.bin&quot;" />
  </Target>

</Project>

